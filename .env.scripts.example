# Secrets for the server-side scripts (scripts/*.mjs). NOT used by the app.
# Copy this file to .env.scripts (which is git-ignored) and fill in the key.
#
# The service_role key bypasses Row Level Security — treat it like a password.
# Never commit it, and never give it a VITE_ prefix (that would bundle it into
# the public site). Get it from:
#   Supabase dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)

SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to VITE_SUPABASE_URL from .env, so you usually don't need this.
# SUPABASE_URL=https://uoagpyprgmcxogobkzuw.supabase.co
